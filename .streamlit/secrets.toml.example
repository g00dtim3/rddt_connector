# Copie ce fichier en .streamlit/secrets.toml (jamais commité) et renseigne les valeurs.
# En production (Streamlit Community Cloud ou autre), ces mêmes clés sont saisies
# dans les paramètres "Secrets" de l'app plutôt que dans un fichier.

# Mot de passe d'accès à l'application : au moins 16 caractères, aléatoire, jamais dans Git.
# Doit rester EN HAUT du fichier, avant toute section [..].
APP_PASSWORD = ""

[brandwatch]
username = ""
password = ""
client_id = "brandwatch-api-client"
base_url = "https://api.brandwatch.com"

[supabase]
host = ""
port = 5432
dbname = "postgres"
user = ""
password = ""
